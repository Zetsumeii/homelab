# {{ ansible_managed }}

[Unit]
Description=GitHub Actions runner ({{ github_runner_name }})
After=network-online.target{{ ' docker.service' if github_runner_docker | bool else '' }}
Wants=network-online.target

[Service]
User={{ github_runner_user }}
WorkingDirectory={{ github_runner_dir }}
ExecStart={{ github_runner_dir }}/run.sh
Restart=always
RestartSec=10
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
