[Unit]
Description="Vault Instance"
Requires=network-online.target
After=network-online.target
# The listener binds the docker proxy-network gateway, which does not
# exist until docker has brought the bridge up.
After=docker.service
Wants=docker.service
ConditionPathExists={{ vault_directory }}

[Service]
User={{ vault_user }}
Group={{ vault_group }}
ExecStart=/bin/sh -c 'exec {{ vault_directory }}/bin/vault server -config={{ vault_directory }}/config/vault-server.hcl'
ExecReload=/bin/kill --signal HUP $MAINPID
# Required so Vault can mlock its memory (disable_mlock = false), which
# keeps the unseal key and secrets from being paged to disk.
AmbientCapabilities=CAP_IPC_LOCK
CapabilityBoundingSet=CAP_IPC_LOCK
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
KillMode=process
KillSignal=SIGINT
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StartLimitInterval=60
StartLimitBurst=3
LimitNOFILE=524288
LimitNPROC=524288
LimitCORE=0

[Install]
WantedBy=multi-user.target
